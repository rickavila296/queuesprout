# Production worker settings. Copy to .env next to compose.yml; never commit it.

NODE_ENV=production
# live posts for real. Keep mock until the web app and channels are set up.
PUBLISH_MODE=mock
LOG_LEVEL=info
MIGRATE_ON_START=true

# Supabase session pooler (IPv4, port 5432) as the owner role from deploy/supabase/setup.sql.
# The user name carries the project ref: queuesprout.<project-ref>
WORKER_DATABASE_URL=postgres://queuesprout.PROJECT_REF:WORKER_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase's CA certificate, base64-encoded on one line (see the deploy guide).
DATABASE_SSL_CA=

# Same value as on Vercel: tokens encrypted by the web app are decrypted here.
TOKEN_ENCRYPTION_KEY=
PUBLIC_URL=https://queuesprout.com

RESEND_API_KEY=
EMAIL_FROM=QueueSprout <hello@queuesprout.com>

# Supabase Storage, S3 protocol (Storage > S3 Configuration in the dashboard).
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=REGION
S3_BUCKET=queuesprout-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

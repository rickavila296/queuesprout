{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["PUBLIC_URL", "NEXT_PUBLIC_*"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^typecheck"]
    },
    "test:integration": {
      "cache": false,
      "env": ["TEST_DATABASE_URL", "TEST_S3_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

# Copy to .env (never commit .env). Defaults match docker/compose.dev.yml.

# --- Database -------------------------------------------------------------
# apps/web connects as the RLS-bound web role.
DATABASE_URL=postgres://queuesprout_web:queuesprout_web@localhost:5432/queuesprout
# apps/worker and migrations connect as the owner role (bypasses RLS).
WORKER_DATABASE_URL=postgres://queuesprout:queuesprout@localhost:5432/queuesprout

# --- App ------------------------------------------------------------------
PUBLIC_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Encrypts social account tokens at rest (AES-256-GCM). 32 random bytes:
# `openssl rand -base64 32`. To rotate: TOKEN_ENCRYPTION_KEY=2:<new>,1:<old> (first is current).
# Losing it means every connected account must reconnect.
TOKEN_ENCRYPTION_KEY=
# mock (default) never calls a platform. Never set live outside production.
PUBLISH_MODE=mock

# --- Sign-in providers (optional; buttons appear only when both are set) ----
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers (OAuth App)
#   Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ----------------------------------------------------------------
# Without a key, sign-in and invite links print to the web server console (dev only).
RESEND_API_KEY=
EMAIL_FROM=QueueSprout <hello@localhost>

# --- Storage (S3-compatible; SeaweedFS locally, Cloudflare R2 in the cloud) -
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_BUCKET=queuesprout-media
S3_ACCESS_KEY_ID=queuesprout
S3_SECRET_ACCESS_KEY=queuesprout-s3-secret
S3_FORCE_PATH_STYLE=true

# --- Worker ---------------------------------------------------------------
LOG_LEVEL=info
MIGRATE_ON_START=true
